    "out": "t"
  },
  {
    "name": "xss-script: script removed with content",
    "in": "<script>alert(1)</script>ok",
    "out": "ok"
  },
  {
    "name": "xss-script: script with src",
    "in": "<script src=//evil.test/x.js></script>t",
    "out": "t"
  },
  {
    "name": "xss-script: script inside allowed tag",
    "in": "<b>a<script>alert(1)</script>c</b>",
    "out": "<b>ac</b>"
  },
  {
    "name": "xss-script: unterminated script dropped",
