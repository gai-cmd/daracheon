[
  {
    "name": "keep: plain korean text",
    "in": "안녕하세요 대라천 침향",
    "out": "안녕하세요 대라천 침향"
  },
  {
    "name": "keep: tag b",
    "in": "<b>a</b>",
    "out": "<b>a</b>"
  },
  {
    "name": "keep: tag strong",
    "in": "<strong>a</strong>",
    "out": "<strong>a</strong>"
  },
  {
    "name": "keep: tag i",
    "in": "<i>a</i>",
    "out": "<i>a</i>"
  },
  {
    "name": "keep: tag em",
    "in": "<em>a</em>",
    "out": "<em>a</em>"
  },
  {
    "name": "keep: tag u",
    "in": "<u>a</u>",
    "out": "<u>a</u>"
  },
  {
    "name": "keep: tag s",
    "in": "<s>a</s>",
    "out": "<s>a</s>"
  },
  {
    "name": "keep: tag small",
    "in": "<small>a</small>",
    "out": "<small>a</small>"
  },
  {
    "name": "keep: tag mark",
    "in": "<mark>a</mark>",
    "out": "<mark>a</mark>"
  },
  {
    "name": "keep: tag sup",
    "in": "m<sup>2</sup>",
    "out": "m<sup>2</sup>"
  },
  {
    "name": "keep: tag sub",
    "in": "H<sub>2</sub>O",
    "out": "H<sub>2</sub>O"
  },
  {
    "name": "keep: tag code",
    "in": "<code>x = 1</code>",
    "out": "<code>x = 1</code>"
  },
  {
    "name": "keep: tag abbr",
    "in": "<abbr>AGAL</abbr>",
    "out": "<abbr>AGAL</abbr>"
  },
  {
    "name": "keep: tag span",
    "in": "<span>a</span>",
    "out": "<span>a</span>"
  },
  {
    "name": "keep: br void",
    "in": "a<br>b",
    "out": "a<br>b"
  },
  {
    "name": "keep: br self-closing is normalized",
    "in": "a<br/>b",
    "out": "a<br>b"
  },
  {
    "name": "keep: closing br tag acts as br",
    "in": "a</br>b",
    "out": "a<br>b"
  },
  {
    "name": "keep: nested inline tags",
    "in": "<b><i>a</i><u>b</u></b>",
    "out": "<b><i>a</i><u>b</u></b>"
  },
  {
    "name": "keep: mixed text and inline tags",
    "in": "침향 <b>3년</b>, <em>숙성</em> 후 <span>출고</span>",
    "out": "침향 <b>3년</b>, <em>숙성</em> 후 <span>출고</span>"
  },
  {
    "name": "keep: newlines and spaces are preserved",
    "in": "a\n  b\t c",
    "out": "a\n  b\t c"
  },
  {
    "name": "keep: class safe value",
    "in": "<span class=\"hl a-b_c 1\">x</span>",
    "out": "<span class=\"hl a-b_c 1\">x</span>"
  },
  {
    "name": "keep: style color",
    "in": "<span style=\"color:#aa3322\">x</span>",
    "out": "<span style=\"color:#aa3322\">x</span>"
  },
  {
    "name": "keep: style font-size and font-weight",
    "in": "<span style=\"font-size:28px;font-weight:700\">x</span>",
    "out": "<span style=\"font-size:28px;font-weight:700\">x</span>"
  },
  {
    "name": "keep: style font-style letter-spacing line-height",
    "in": "<span style=\"font-style:italic;letter-spacing:-0.02em;line-height:1.6\">x</span>",
    "out": "<span style=\"font-style:italic;letter-spacing:-0.02em;line-height:1.6\">x</span>"
  },
  {
    "name": "keep: style text-decoration opacity",
    "in": "<span style=\"text-decoration:underline;opacity:.8\">x</span>",
    "out": "<span style=\"text-decoration:underline;opacity:.8\">x</span>"
  },
  {
    "name": "keep: style white-space word-break",
    "in": "<span style=\"white-space:nowrap;word-break:keep-all\">x</span>",
    "out": "<span style=\"white-space:nowrap;word-break:keep-all\">x</span>"
  },
  {
    "name": "keep: style background-color",
    "in": "<span style=\"background-color:#fff3cd\">x</span>",
    "out": "<span style=\"background-color:#fff3cd\">x</span>"
  },
  {
    "name": "keep: style color with rgba()",
    "in": "<span style=\"color:rgba(0,0,0,.5)\">x</span>",
    "out": "<span style=\"color:rgba(0,0,0,.5)\">x</span>"
  },
  {
    "name": "keep: real s2_check case: background shorthand with one hex color",
    "in": "<span class=\"yes\" style=\"background:#85858C\">O</span>",
    "out": "<span class=\"yes\" style=\"background:#85858C\">O</span>"
  },
  {
    "name": "keep: background shorthand with rgb()",
    "in": "<span style=\"background:rgb(10, 20, 30)\">x</span>",
    "out": "<span style=\"background:rgb(10, 20, 30)\">x</span>"
  },
  {
    "name": "keep: background shorthand with a color keyword",
    "in": "<span style=\"background:gold\">x</span>",
    "out": "<span style=\"background:gold\">x</span>"
  },
  {
    "name": "keep: style with trailing semicolon is kept verbatim",
    "in": "<span style=\"color:red;\">x</span>",
    "out": "<span style=\"color:red;\">x</span>"
  },
  {
    "name": "keep: anchor https with forced rel",
    "in": "<a href=\"https://example.com/a?b=1\">x</a>",
    "out": "<a href=\"https://example.com/a?b=1\" rel=\"noopener noreferrer\">x</a>"
  },
  {
    "name": "keep: anchor http",
    "in": "<a href=\"http://example.com\">x</a>",
    "out": "<a href=\"http://example.com\" rel=\"noopener noreferrer\">x</a>"
  },
  {
    "name": "keep: anchor mailto and tel",
    "in": "<a href=\"mailto:a@b.co\">m</a><a href=\"tel:+8210\">t</a>",
    "out": "<a href=\"mailto:a@b.co\" rel=\"noopener noreferrer\">m</a><a href=\"tel:+8210\" rel=\"noopener noreferrer\">t</a>"
  },
  {
    "name": "keep: anchor target _blank and _self",
    "in": "<a href=\"https://e.test\" target=\"_blank\">a</a><a href=\"https://e.test\" target=\"_self\">b</a>",
    "out": "<a href=\"https://e.test\" target=\"_blank\" rel=\"noopener noreferrer\">a</a><a href=\"https://e.test\" target=\"_self\" rel=\"noopener noreferrer\">b</a>"
  },
  {
    "name": "keep: anchor with correct rel stays as is",
    "in": "<a href=\"https://e.test\" rel=\"noopener noreferrer\">a</a>",
    "out": "<a href=\"https://e.test\" rel=\"noopener noreferrer\">a</a>"
  },
  {
    "name": "keep: anchor inside styled span",
    "in": "<span style=\"color:red\"><a href=\"https://e.test\">x</a></span>",
    "out": "<span style=\"color:red\"><a href=\"https://e.test\" rel=\"noopener noreferrer\">x</a></span>"
  },
  {
    "name": "keep: uppercase href scheme",
    "in": "<a href=\"HTTPS://E.TEST/x\">x</a>",
    "out": "<a href=\"HTTPS://E.TEST/x\" rel=\"noopener noreferrer\">x</a>"
  },
  {
    "name": "keep: text entities stay escaped",
    "in": "a &amp; b &lt;script&gt;alert(1)&lt;/script&gt;",
    "out": "a &amp; b &lt;script&gt;alert(1)&lt;/script&gt;"
  },
  {
    "name": "keep: nbsp serialized as entity",
    "in": "a&nbsp;b",
    "out": "a&nbsp;b"
  },
  {
    "name": "keep: quotes and gt in text",
    "in": "say \"hi\" &gt; there",
    "out": "say \"hi\" &gt; there"
  },
  {
    "name": "keep: emoji and CJK",
    "in": "<b>한글</b> 日本語 🙂",
    "out": "<b>한글</b> 日本語 🙂"
  },
  {
    "name": "keep: attribute names are lowercased, values untouched",
    "in": "<SPAN CLASS=\"a\" STYLE=\"COLOR:RED\">x</SPAN>",
    "out": "<span class=\"a\" style=\"COLOR:RED\">x</span>"
  },
  {
    "name": "keep: empty input",
    "in": "",
    "out": ""
  },
  {
    "name": "attr: event handler attribute dropped",
    "in": "<span onclick=\"alert(1)\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: onmouseover on allowed tag dropped",
    "in": "<b onmouseover=alert(1)>x</b>",
    "out": "<b>x</b>"
  },
  {
    "name": "attr: slash-separated event handler dropped",
    "in": "<b/onclick=alert(1)>x</b>",
    "out": "<b>x</b>"
  },
  {
    "name": "attr: id data aria title dropped",
    "in": "<span id=\"a\" data-x=\"1\" title=\"t\" aria-label=\"l\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: abbr title dropped",
    "in": "<abbr title=\"t\">x</abbr>",
    "out": "<abbr>x</abbr>"
  },
  {
    "name": "attr: lang dir contenteditable dropped",
    "in": "<span lang=\"ko\" dir=\"rtl\" contenteditable=\"true\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: class with quote and angle bracket dropped",
    "in": "<span class=\"a&quot;b&lt;c\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: class longer than 80 chars dropped",
    "in": "<span class=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: empty class dropped",
    "in": "<span class=\"\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: href on non-anchor dropped",
    "in": "<span href=\"https://e.test\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: target on non-anchor dropped",
    "in": "<span target=\"_blank\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: target other than _blank/_self dropped",
    "in": "<a href=\"https://e.test\" target=\"_top\">b</a>",
    "out": "<a href=\"https://e.test\" rel=\"noopener noreferrer\">b</a>"
  },
  {
    "name": "attr: foreign rel replaced",
    "in": "<a href=\"https://e.test\" rel=\"opener\">a</a>",
    "out": "<a href=\"https://e.test\" rel=\"noopener noreferrer\">a</a>"
  },
  {
    "name": "attr: rel on non-anchor dropped",
    "in": "<span rel=\"noopener\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: anchor ping download hreflang dropped",
    "in": "<a href=\"https://e.test\" ping=\"https://t.test\" download=\"f\" hreflang=\"ko\">a</a>",
    "out": "<a href=\"https://e.test\" rel=\"noopener noreferrer\">a</a>"
  },
  {
    "name": "attr: relative href dropped",
    "in": "<a href=\"/about\">x</a>",
    "out": "<a rel=\"noopener noreferrer\">x</a>"
  },
  {
    "name": "attr: fragment href dropped",
    "in": "<a href=\"#top\">x</a>",
    "out": "<a rel=\"noopener noreferrer\">x</a>"
  },
  {
    "name": "attr: protocol-relative href dropped",
    "in": "<a href=\"//evil.test/x\">x</a>",
    "out": "<a rel=\"noopener noreferrer\">x</a>"
  },
  {
    "name": "attr: ftp href dropped",
    "in": "<a href=\"ftp://e.test/x\">x</a>",
    "out": "<a rel=\"noopener noreferrer\">x</a>"
  },
  {
    "name": "attr: style: disallowed property dropped, allowed kept",
    "in": "<span style=\"color:red;position:fixed;font-size:20px\">x</span>",
    "out": "<span style=\"color:red; font-size:20px\">x</span>"
  },
  {
    "name": "attr: style: only disallowed properties removes the attribute",
    "in": "<span style=\"position:fixed;z-index:9\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: style: declaration without colon dropped",
    "in": "<span style=\"color\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: style: calc with plus is not an allowed value",
    "in": "<span style=\"font-size:calc(1rem + 2px)\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: style: important flag not allowed",
    "in": "<span style=\"color:red !important\">x</span>",
    "out": "<span>x</span>"
  },
  {
    "name": "attr: style: comment inside value not allowed",
    "in": "<span style=\"color:red/**/\">x</span>",
    "out": "<span>x</span>"
  },
